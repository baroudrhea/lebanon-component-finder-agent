    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const agentItem = $('Component Finder Agent').itemMatching(i);\n  const webhookItem = $('Webhook').itemMatching(i);\n\n  const answer = agentItem.json.answer || \"No answer available\";\n  const query = webhookItem.json.body.component;\n  const rate = item.json.rates ? item.json.rates.LBP : null;\n\n  let priceNote = \"\";\n  if (rate) {\n    priceNote = ` (today's rate: 1 USD ≈ ${rate} LBP)`;\n  }\n\n  results.push({\n    json: {\n      query,\n      answer,\n      lbpRate: rate,\n      summary: `${answer}${priceNote}`,\n      searchedAt: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
